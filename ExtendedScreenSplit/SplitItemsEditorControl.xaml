<UserControl x:Class="YMM4.ExtendedScreenSplit.SplitItemsEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="140" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ListBox Grid.Row="0"
                 ItemsSource="{Binding Items}"
                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid MinWidth="260">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Margin="4,0,10,0"
                                   Text="{Binding ItemNumber, StringFormat=アイテム {0}}" />
                        <TextBox Grid.Column="1"
                                 MinWidth="80"
                                 VerticalContentAlignment="Center"
                                 ToolTip="このアイテムの備考"
                                 Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                                 GotKeyboardFocus="Remark_GotKeyboardFocus"
                                 LostKeyboardFocus="Remark_LostKeyboardFocus" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ContentControl x:Name="SelectedItemEditorHost" Grid.Row="1" />
    </Grid>
</UserControl>
